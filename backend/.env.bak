# Anthropic Claude API key — used for ALL agents:
#   - Operationalizer (Dr. Mira Chen)        → Claude Opus
#   - Critic (Marcus Webb)                   → Claude Sonnet
#   - Modularizer (Dr. Anika Patel)          → Claude Sonnet
#   - Synthesizer (James Harrington)         → Claude Sonnet
ANTHROPIC_API_KEY=your-anthropic-key-here

# Model identifiers
OPUS_MODEL=claude-opus-4-7
SONNET_MODEL=claude-sonnet-4-6

# LLM generation settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Storage
DATA_FILE_PATH=./data/questions.json

# Simple API key auth for FastAPI routes (set any secret string)
API_KEY=minokane-dev-key

# Observability
LOG_LEVEL=INFO

# Anthropic native web_search server tool — used by the Operationalizer
# to ground resolution criteria/sources in current facts. Set to false
# to fall back to the model's training knowledge only.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=3
