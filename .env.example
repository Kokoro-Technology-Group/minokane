# Anthropic Claude API key — used for ALL agents:
#   - Operationalizer (Dr. Mira Chen)        → Claude Opus
#   - Critic (Marcus Webb)                   → Claude Sonnet
#   - Modularizer (Dr. Anika Patel)          → Claude Sonnet
#   - Synthesizer (James Harrington)         → Claude Sonnet
ANTHROPIC_API_KEY=your-anthropic-key-here

# Model identifiers
OPUS_MODEL=claude-opus-4-7
SONNET_MODEL=claude-sonnet-4-6

# LLM generation settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Storage
DATA_FILE_PATH=./data/questions.json

# Simple API key auth for FastAPI routes (set any secret string)
API_KEY=minokane-dev-key

# Observability
LOG_LEVEL=INFO

# Anthropic native web_search server tool — used by the Operationalizer
# to ground resolution criteria/sources in current facts. Set to false
# to fall back to the model's training knowledge only.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=3

# ---- Think stage: prediction-market matching (Metaculus + Manifold) --------
# Manifold reads are public (no key). Metaculus reads now REQUIRE an API token;
# leave METACULUS_API_TOKEN empty to run Manifold-only (honest partial coverage).
# Get a token at https://www.metaculus.com/accounts/settings/ (API section).
MANIFOLD_BASE_URL=https://api.manifold.markets/v0
METACULUS_BASE_URL=https://www.metaculus.com/api2
METACULUS_API_TOKEN=

MARKET_SEARCH_LIMIT=6
MARKET_FETCH_CONCURRENCY=6
MARKET_HTTP_TIMEOUT=15.0
MARKET_CACHE_TTL=900
MARKET_MAX_BETS=4000
MARKET_MATCH_MIN_CONFIDENCE=medium
MAX_MAJORS=5
MAX_MINORS_PER_MAJOR=4
