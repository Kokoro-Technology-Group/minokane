---
/**
 * testdraft — rough-draft prototype of the Ask / Think / Show flow.
 * Frontend only, fake data, no backend. Launched via ./testdraft.sh -> /testdraft.
 */
import Layout from "../layouts/Layout.astro";
import AskPhase from "../components/testdraft/AskPhase.astro";
import ThinkPhase from "../components/testdraft/ThinkPhase.astro";
import ShowPhase from "../components/testdraft/ShowPhase.astro";

const phases = [
  { id: "ask", label: "Ask" },
  { id: "think", label: "Think" },
  { id: "show", label: "Show" },
];
---

<Layout title="Minokane — testdraft">
  <div class="td-wrapper">
    <header class="td-header">
      <h1>minokane <span class="td-tag">draft</span></h1>
      <nav class="td-progress" aria-label="Phases">
        {
          phases.map((p, i) => (
            <button class:list={["td-step", i === 0 && "is-active"]} data-phase={p.id} disabled={i !== 0}>
              <span class="td-step-num">{i + 1}</span>
              <span class="td-step-label">{p.label}</span>
            </button>
          ))
        }
      </nav>
    </header>

    <main class="td-stage">
      <div class="td-phase" data-phase="ask"><AskPhase /></div>
      <div class="td-phase" data-phase="think" hidden><ThinkPhase /></div>
      <div class="td-phase" data-phase="show" hidden><ShowPhase /></div>
    </main>
  </div>
</Layout>

<script>
  type Phase = "ask" | "think" | "show";
  const ORDER: Phase[] = ["ask", "think", "show"];

  const phaseEls = new Map<Phase, HTMLElement>();
  ORDER.forEach((p) => {
    phaseEls.set(p, document.querySelector<HTMLElement>(`.td-phase[data-phase="${p}"]`)!);
  });
  const stepBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".td-step"));

  let visited = new Set<Phase>(["ask"]);

  function goto(phase: Phase) {
    ORDER.forEach((p) => {
      phaseEls.get(p)!.hidden = p !== phase;
    });
    visited.add(phase);

    stepBtns.forEach((btn) => {
      const p = btn.dataset.phase as Phase;
      btn.classList.toggle("is-active", p === phase);
      btn.classList.toggle("is-done", visited.has(p) && p !== phase);
      btn.disabled = !visited.has(p);
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
    // Let the phase component know it is now on screen.
    document.dispatchEvent(new CustomEvent("testdraft:entered", { detail: { phase } }));
  }

  // Child phases request advancing.
  document.addEventListener("testdraft:phase", (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.phase) goto(detail.phase as Phase);
  });

  // Progress bar jump-back to any visited phase.
  stepBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const p = btn.dataset.phase as Phase;
      if (visited.has(p)) goto(p);
    });
  });
</script>

<style>
  .td-wrapper {
    min-height: 100vh;
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }
  .td-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .td-header h1 {
    font-size: 1.6rem;
    font-weight: 300;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .td-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }

  .td-progress {
    display: flex;
    gap: 0.5rem;
    background: var(--color-surface);
    padding: 0.4rem;
    border-radius: 999px;
    width: 100%;
    box-sizing: border-box;
  }
  .td-step {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border: none;
    background: transparent;
    border-radius: 999px;
    font: inherit;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .td-step:disabled { cursor: not-allowed; opacity: 0.55; }
  .td-step.is-active {
    background: var(--color-bg);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
    font-weight: 500;
  }
  .td-step.is-done { color: var(--color-primary); }
  .td-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .td-step.is-active .td-step-num { background: var(--color-primary); color: #fff; }
  .td-step-label { font-size: 0.9rem; }

  .td-phase[hidden] { display: none; }
</style>
