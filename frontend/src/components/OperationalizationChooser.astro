---
---

<section class="chooser" id="chooser-section">
  <div class="chooser-header">
    <h2>Choose your operationalization</h2>
    <p class="chooser-sub">
      Select the version that best captures your intent. You may edit any field inline before confirming.
    </p>
    <div id="critic-feedback" class="critic-note" hidden></div>
  </div>

  <div id="options-list" class="options-list"></div>

  <div id="chooser-error" class="error-msg" hidden role="alert"></div>

  <div id="chooser-loading" hidden role="status" aria-live="polite">
    <div class="spinner-wrap">
      <div class="spinner"></div>
      <p class="spinner-msg">Dr. Anika Patel is decomposing your question…<br /><span class="spinner-sub">James Harrington is writing the summary. This may take 30–60 seconds.</span></p>
    </div>
  </div>

  <div class="confirm-row">
    <div class="feedback-field">
      <label for="user-feedback">High-level feedback <span class="optional">(optional)</span></label>
      <textarea
        id="user-feedback"
        rows="2"
        placeholder="e.g. focus on FOMC statement language, not market expectations"
      ></textarea>
    </div>
    <button id="confirm-btn" class="btn btn--primary" disabled>
      Confirm Selection →
    </button>
  </div>
</section>

<template id="option-card-template">
  <div class="option-card">
    <div class="option-summary">
      <input type="radio" name="operationalization" class="option-radio" />
      <span class="option-index"></span>
      <p class="field-text option-text" contenteditable="true"></p>
      <button type="button" class="option-toggle" aria-expanded="false">Details ▾</button>
    </div>
    <div class="option-details" hidden>
      <div class="option-field">
        <span class="field-label">Resolution criteria</span>
        <p class="field-text option-criteria" contenteditable="true"></p>
      </div>
      <div class="option-field">
        <span class="field-label">Resolution source</span>
        <p class="field-text option-source" contenteditable="true"></p>
      </div>
      <div class="option-field option-field--row">
        <div>
          <span class="field-label">Deadline</span>
          <input type="date" class="option-deadline" />
        </div>
        <div class="outcome-editor-cell">
          <span class="field-label">
            Outcome <span class="outcome-type-badge"></span>
          </span>
          <div class="outcome-editor"></div>
        </div>
      </div>
      <div class="option-field">
        <span class="field-label">Void conditions</span>
        <p class="field-text option-void" contenteditable="true"></p>
      </div>
    </div>
  </div>
</template>

<style>
  .chooser {
    width: 100%;
  }

  .chooser-header {
    margin-bottom: 1.5rem;
  }

  .chooser-header h2 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .chooser-sub {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }

  .critic-note {
    background: rgba(18, 174, 245, 0.08);
    border: 1px solid rgba(18, 174, 245, 0.25);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .option-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    cursor: default;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .option-card:has(.option-radio:checked) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(18, 174, 245, 0.15);
  }

  .option-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
  }

  .option-radio {
    accent-color: var(--color-primary);
    width: 18px;
    height: 18px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .option-index {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    min-width: 1.5rem;
  }

  .option-text {
    flex: 1;
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .option-toggle {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    flex-shrink: 0;
  }

  .option-toggle:hover { color: var(--color-text); }

  .option-details {
    padding: 0 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0;
    padding-top: 1rem;
  }

  .option-details[hidden] { display: none; }

  .option-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .option-field--row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .outcome-type-badge {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: rgba(18, 174, 245, 0.12);
    color: var(--color-primary);
    text-transform: lowercase;
  }

  .field-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
    border-radius: 4px;
    padding: 4px 6px;
    transition: background 0.15s;
    outline: none;
  }

  .field-text[contenteditable="true"] {
    cursor: text;
  }

  .field-text[contenteditable="true"]:hover {
    background: rgba(18, 174, 245, 0.06);
  }

  .field-text[contenteditable="true"]:focus {
    background: rgba(18, 174, 245, 0.1);
    box-shadow: 0 0 0 2px rgba(18, 174, 245, 0.3);
  }

  .option-deadline,
  .outcome-editor input {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.35rem 0.5rem;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--color-text);
    box-sizing: border-box;
  }

  .option-deadline { width: 100%; }

  .outcome-editor {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.25rem;
  }

  .outcome-editor input[type="number"] { width: 8rem; }
  .outcome-editor input[type="date"] { width: 100%; }
  .outcome-editor .outcome-unit {
    font-size: 0.85rem;
    color: var(--color-text);
    padding: 4px 6px;
    border-radius: 4px;
  }
  .outcome-editor .outcome-unit[contenteditable="true"]:hover {
    background: rgba(18, 174, 245, 0.06);
    cursor: text;
  }

  .confirm-row {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
  }

  .feedback-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .feedback-field label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .feedback-field .optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .feedback-field textarea {
    width: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-text);
    resize: vertical;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .feedback-field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border-radius: 8px;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
    flex-shrink: 0;
  }

  .btn--primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn:hover { opacity: 0.88; }
  .btn:active { transform: scale(0.98); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .error-msg {
    color: #e05c5c;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgba(224, 92, 92, 0.1);
    border-radius: 6px;
  }

  .spinner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    text-align: center;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .spinner-msg {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.6;
  }

  .spinner-sub { font-size: 0.8rem; opacity: 0.7; }

  @keyframes spin { to { transform: rotate(360deg); } }
</style>
