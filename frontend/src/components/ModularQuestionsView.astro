---
---

<section class="results" id="results-section">
  <div id="selected-question-card" class="selected-card"></div>

  <div id="summary-card" class="summary-card"></div>

  <div class="sub-questions-header">
    <h3>Modular sub-questions</h3>
    <p class="sub-q-note">Each driver independently shapes the main forecast.</p>
  </div>

  <div id="sub-questions-list" class="sub-questions-list"></div>

  <button id="reset-btn" class="btn btn--ghost">Start a new forecast</button>
</section>

<template id="sub-question-template">
  <div class="sub-q-card">
    <div class="sub-q-body">
      <p class="sub-q-text"></p>
      <p class="sub-q-explanation"></p>
    </div>
    <div class="sub-q-tags">
      <span class="tag tag--domain"></span>
      <span class="tag tag--importance"></span>
      <span class="tag tag--likelihood"></span>
    </div>
  </div>
</template>

<style>
  .results {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .selected-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .selected-card h2 {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .selected-card p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .selected-card .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .summary-card {
    background: linear-gradient(135deg, rgba(18, 174, 245, 0.06), rgba(18, 174, 245, 0.02));
    border: 1px solid rgba(18, 174, 245, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .summary-card h2 {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .summary-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text);
    white-space: pre-wrap;
  }

  .sub-questions-header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sub-questions-header h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .sub-q-note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin: 0;
  }

  .sub-questions-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sub-q-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .sub-q-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sub-q-text {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.5;
  }

  .sub-q-explanation {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .sub-q-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .tag--domain {
    background: rgba(18, 174, 245, 0.12);
    color: var(--color-primary);
  }

  /* importance colors */
  .tag--importance-high { background: rgba(52, 168, 83, 0.12); color: #2d8a47; }
  .tag--importance-medium { background: rgba(251, 188, 4, 0.15); color: #a07c00; }
  .tag--importance-low { background: rgba(128, 128, 128, 0.12); color: #666; }

  /* likelihood colors */
  .tag--likelihood-high { background: rgba(52, 168, 83, 0.12); color: #2d8a47; }
  .tag--likelihood-medium { background: rgba(251, 188, 4, 0.15); color: #a07c00; }
  .tag--likelihood-low { background: rgba(224, 92, 92, 0.12); color: #c0392b; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-muted);
  }

  .btn:hover { opacity: 0.7; }
</style>
