---
interface Props {
  message?: string;
}
const { message = "Running agent pipeline…" } = Astro.props;
---

<div class="spinner-wrap" aria-live="polite">
  <div class="spinner"></div>
  <p class="spinner-msg">{message}</p>
</div>

<style>
  .spinner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2.5rem 0;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .spinner-msg {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
