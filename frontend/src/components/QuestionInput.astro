---
---

<section class="question-input">
  <form id="question-form" novalidate>
    <div class="field">
      <label for="raw-question">Your forecast question</label>
      <textarea
        id="raw-question"
        name="raw_question"
        rows="4"
        placeholder="e.g. Will the Fed cut interest rates by December 2026?"
        required
        autocomplete="off"
      ></textarea>
    </div>

    <div class="field-row">
      <div class="field field--half">
        <label for="deadline">Deadline <span class="optional">(optional)</span></label>
        <input
          type="datetime-local"
          id="deadline"
          name="deadline"
          placeholder="Resolution deadline"
        />
      </div>

      <div class="field field--half">
        <label for="outcome">Expected outcome <span class="optional">(optional)</span></label>
        <input
          type="text"
          id="outcome"
          name="outcome_description"
          placeholder="e.g. rates are cut by ≥25 bps"
        />
      </div>
    </div>

    <div id="question-error" class="error-msg" hidden></div>

    <button type="submit" id="submit-btn" class="btn btn--primary">
      Operationalize →
    </button>
  </form>

  <div id="question-loading" hidden>
    <div class="spinner-wrap">
      <div class="spinner"></div>
      <p class="spinner-msg">Dr. Mira Chen is operationalizing your question…<br /><span class="spinner-sub">Marcus Webb is reviewing. This may take 30–60 seconds.</span></p>
    </div>
  </div>
</section>

<style>
  .question-input {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .field-row {
    display: flex;
    gap: 1rem;
  }

  .field--half {
    flex: 1;
  }

  label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  textarea,
  input[type="text"],
  input[type="datetime-local"] {
    width: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text);
    resize: vertical;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  textarea:focus,
  input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border-radius: 8px;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
  }

  .btn--primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn:hover { opacity: 0.88; }
  .btn:active { transform: scale(0.98); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .error-msg {
    color: #e05c5c;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgba(224, 92, 92, 0.1);
    border-radius: 6px;
  }

  .spinner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    text-align: center;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .spinner-msg {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.6;
  }

  .spinner-sub {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
