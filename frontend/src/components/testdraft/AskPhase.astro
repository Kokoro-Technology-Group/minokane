---
/**
 * ASK phase — two screens, wired to the live backend:
 *   1. Question input (question + deadline + outcome description).
 *      → POST /questions -> operationalized candidates.
 *   2. Choose operationalization: pick 1 of up to 3 candidates, edit any field
 *      inline, optional feedback. → PUT /questions/{id}/select -> forecast tree.
 *
 * Stores the session in session-store, then emits `testdraft:phase`
 * -> { phase: "think" }. Resets on re-entry (Start over).
 */
---

<section class="ask">
  <!-- Screen 1: input -->
  <div class="ask-screen" id="ask-input">
    <h2>Ask</h2>
    <p class="ask-sub">State the question you want to forecast.</p>

    <label class="field-label" for="td-question">Your question</label>
    <textarea id="td-question" class="td-input" rows="3" placeholder="Will a major AI lab release a model beating humans at competitive math by end of 2026?"></textarea>

    <div class="ask-row">
      <div class="ask-col">
        <label class="field-label" for="td-deadline">Deadline <span class="opt">(optional)</span></label>
        <input id="td-deadline" class="td-input" type="date" />
      </div>
      <div class="ask-col">
        <label class="field-label" for="td-outcome">Outcome <span class="opt">(optional)</span></label>
        <input id="td-outcome" class="td-input" type="text" placeholder="e.g. Yes / No" />
      </div>
    </div>

    <div class="ask-err" id="td-input-err" hidden></div>
    <button class="td-btn" id="td-operationalize">Operationalize →</button>

    <div class="ask-loading" id="td-input-loading" hidden>
      <span class="spinner"></span>
      <span>Operationalizing your question…</span>
    </div>
  </div>

  <!-- Screen 2: choose operationalization -->
  <div class="ask-screen" id="ask-chooser" hidden>
    <h2>Choose</h2>
    <p class="ask-sub">
      Pick the version that best captures your intent. Edit any field inline before confirming.
    </p>

    <div class="orig-q" id="td-orig-q" hidden>
      <span class="orig-q-label">Your question</span>
      <p id="td-orig-q-text"></p>
    </div>

    <div id="td-options" class="options-list"></div>

    <div class="ask-err" id="td-chooser-err" hidden></div>

    <div class="feedback-field">
      <label class="field-label" for="td-feedback">High-level feedback <span class="opt">(optional)</span></label>
      <textarea id="td-feedback" rows="2" placeholder="e.g. focus on gold-medal threshold, not median"></textarea>
    </div>

    <div class="ask-actions">
      <button class="td-btn td-btn--ghost" id="td-back">← Back</button>
      <button class="td-btn" id="td-confirm" disabled>Start thinking →</button>
    </div>

    <div class="ask-loading" id="td-chooser-loading" hidden>
      <span class="spinner"></span>
      <span>Decomposing &amp; matching markets… this can take 30–60s.</span>
    </div>
  </div>
</section>

<template id="td-option-template">
  <div class="option-card">
    <div class="option-summary">
      <input type="radio" name="td-operationalization" class="option-radio" />
      <span class="option-index"></span>
      <p class="field-text option-text" contenteditable="true"></p>
      <button type="button" class="option-toggle" aria-expanded="false">Details ▾</button>
    </div>
    <div class="option-details" hidden>
      <div class="option-field">
        <span class="field-label">Resolution criteria</span>
        <p class="field-text option-criteria" contenteditable="true"></p>
      </div>
      <div class="option-field">
        <span class="field-label">Resolution source</span>
        <p class="field-text option-source" contenteditable="true"></p>
      </div>
      <div class="option-field option-field--row">
        <div>
          <span class="field-label">Deadline</span>
          <input type="date" class="option-deadline" />
        </div>
        <div>
          <span class="field-label">Outcome <span class="outcome-type-badge"></span></span>
          <div class="outcome-editor"></div>
        </div>
      </div>
      <div class="option-field">
        <span class="field-label">Void conditions</span>
        <p class="field-text option-void" contenteditable="true"></p>
      </div>
    </div>
  </div>
</template>

<script>
  import type { OperationalizedQuestion, OutcomeType, ForecastSession } from "../../scripts/api";
  import { submitQuestion, selectOperationalization } from "../../scripts/api";
  import { setSession, clearSession } from "../../scripts/session-store";

  const MAX_CANDIDATES = 3;

  const inputScreen = document.getElementById("ask-input")!;
  const chooserScreen = document.getElementById("ask-chooser")!;

  const questionEl = document.getElementById("td-question") as HTMLTextAreaElement;
  const deadlineEl = document.getElementById("td-deadline") as HTMLInputElement;
  const outcomeEl = document.getElementById("td-outcome") as HTMLInputElement;
  const opBtn = document.getElementById("td-operationalize") as HTMLButtonElement;
  const inputErr = document.getElementById("td-input-err")!;
  const inputLoading = document.getElementById("td-input-loading")!;

  const origQ = document.getElementById("td-orig-q")!;
  const origQText = document.getElementById("td-orig-q-text")!;
  const optionsList = document.getElementById("td-options")!;
  const chooserErr = document.getElementById("td-chooser-err")!;
  const chooserLoading = document.getElementById("td-chooser-loading")!;
  const feedbackEl = document.getElementById("td-feedback") as HTMLTextAreaElement;
  const backBtn = document.getElementById("td-back") as HTMLButtonElement;
  const confirmBtn = document.getElementById("td-confirm") as HTMLButtonElement;
  const optionTemplate = document.getElementById("td-option-template") as HTMLTemplateElement;

  let currentSession: ForecastSession | null = null;
  let selectedIndex: number | null = null;

  function showErr(el: HTMLElement, msg: string) { el.textContent = msg; el.hidden = false; }
  function clearErr(el: HTMLElement) { el.textContent = ""; el.hidden = true; }

  // ─── Outcome editors (mirror the backend outcome_type shapes) ──────────────
  function renderOutcomeEditor(container: HTMLElement, opt: OperationalizedQuestion) {
    container.innerHTML = "";
    const t: OutcomeType = opt.outcome_type ?? "binary";

    if (t === "date") {
      const dateInput = document.createElement("input");
      dateInput.type = "date";
      dateInput.className = "outcome-value";
      const first = (opt.outcome_options ?? [])[0] ?? "";
      const m = first.match(/\d{4}-\d{2}-\d{2}/);
      if (m) dateInput.value = m[0];
      container.appendChild(dateInput);
      return;
    }
    if (t === "numeric") {
      const numInput = document.createElement("input");
      numInput.type = "number";
      numInput.step = "any";
      numInput.className = "outcome-value";
      const num = parseFloat((opt.outcome_options ?? [])[0] ?? "");
      if (!Number.isNaN(num)) numInput.value = String(num);
      container.appendChild(numInput);
      const unit = document.createElement("span");
      unit.className = "outcome-unit";
      unit.setAttribute("contenteditable", "true");
      unit.textContent = opt.outcome_unit ?? "";
      container.appendChild(unit);
      return;
    }
    const p = document.createElement("p");
    p.className = "field-text option-outcomes";
    p.setAttribute("contenteditable", "true");
    p.textContent = (opt.outcome_options ?? []).join(" / ");
    container.appendChild(p);
  }

  function readOutcomeEditor(container: HTMLElement, opt: OperationalizedQuestion) {
    const t: OutcomeType = opt.outcome_type ?? "binary";
    if (t === "date") {
      const v = (container.querySelector(".outcome-value") as HTMLInputElement)?.value ?? "";
      return { outcome_options: v ? [v] : [], outcome_unit: null as string | null };
    }
    if (t === "numeric") {
      const v = (container.querySelector(".outcome-value") as HTMLInputElement)?.value ?? "";
      const unit = (container.querySelector(".outcome-unit") as HTMLElement)?.innerText.trim() || null;
      return { outcome_options: v ? [v] : [], outcome_unit: unit };
    }
    const p = container.querySelector(".option-outcomes") as HTMLElement | null;
    const raw = p?.innerText ?? "";
    return {
      outcome_options: raw.split("/").map((s) => s.trim()).filter(Boolean),
      outcome_unit: null as string | null,
    };
  }

  // ─── Screen 1: submit ──────────────────────────────────────────────────────
  opBtn.addEventListener("click", async () => {
    clearErr(inputErr);
    const raw = questionEl.value.trim();
    if (!raw) { showErr(inputErr, "Please enter a forecast question."); return; }

    opBtn.disabled = true;
    inputLoading.hidden = false;
    try {
      const session = await submitQuestion({
        raw_question: raw,
        deadline: deadlineEl.value ? new Date(deadlineEl.value).toISOString() : null,
        outcome_description: outcomeEl.value.trim() || null,
      });
      currentSession = session;
      setSession(session);
      origQText.textContent = raw;
      origQ.hidden = false;
      renderChooser(session);
      inputScreen.hidden = true;
      chooserScreen.hidden = false;
    } catch (err) {
      showErr(inputErr, `Error: ${err instanceof Error ? err.message : String(err)}`);
    } finally {
      opBtn.disabled = false;
      inputLoading.hidden = true;
    }
  });

  // ─── Screen 2: render candidates ───────────────────────────────────────────
  function renderChooser(session: ForecastSession) {
    optionsList.innerHTML = "";
    selectedIndex = null;
    confirmBtn.disabled = true;
    feedbackEl.value = "";
    clearErr(chooserErr);

    session.operationalized_options.slice(0, MAX_CANDIDATES).forEach((opt, idx) => {
      const clone = optionTemplate.content.cloneNode(true) as DocumentFragment;
      const radio = clone.querySelector(".option-radio") as HTMLInputElement;
      const indexEl = clone.querySelector(".option-index")!;
      const textEl = clone.querySelector(".option-text") as HTMLElement;
      const toggleBtn = clone.querySelector(".option-toggle") as HTMLButtonElement;
      const detailsEl = clone.querySelector(".option-details") as HTMLElement;
      const summaryEl = clone.querySelector(".option-summary") as HTMLElement;
      const criteriaEl = clone.querySelector(".option-criteria") as HTMLElement;
      const sourceEl = clone.querySelector(".option-source") as HTMLElement;
      const deadlineInput = clone.querySelector(".option-deadline") as HTMLInputElement;
      const outcomeEditor = clone.querySelector(".outcome-editor") as HTMLElement;
      const outcomeBadge = clone.querySelector(".outcome-type-badge") as HTMLElement;
      const voidEl = clone.querySelector(".option-void") as HTMLElement;

      radio.value = String(idx);
      indexEl.textContent = `#${idx + 1}`;
      textEl.textContent = opt.text;
      criteriaEl.textContent = opt.resolution_criteria;
      sourceEl.textContent = opt.resolution_source;
      voidEl.textContent = opt.void_conditions;
      outcomeBadge.textContent = opt.outcome_type ?? "binary";

      const dt = new Date(opt.deadline);
      if (!Number.isNaN(dt.getTime())) {
        const y = dt.getUTCFullYear();
        const m = String(dt.getUTCMonth() + 1).padStart(2, "0");
        const d = String(dt.getUTCDate()).padStart(2, "0");
        deadlineInput.value = `${y}-${m}-${d}`;
      }

      renderOutcomeEditor(outcomeEditor, opt);

      summaryEl.addEventListener("click", (ev) => {
        const target = ev.target as HTMLElement;
        if (target.closest(".option-text") || target.closest(".option-toggle") || target === radio) return;
        radio.checked = true;
        radio.dispatchEvent(new Event("change", { bubbles: true }));
      });
      radio.addEventListener("change", () => {
        if (radio.checked) { selectedIndex = idx; confirmBtn.disabled = false; }
      });
      toggleBtn.addEventListener("click", (ev) => {
        ev.stopPropagation();
        const expanded = !detailsEl.hidden;
        detailsEl.hidden = expanded;
        toggleBtn.setAttribute("aria-expanded", String(!expanded));
        toggleBtn.textContent = expanded ? "Details ▾" : "Details ▴";
      });

      optionsList.appendChild(clone);
    });
  }

  // ─── Screen 2: confirm ─────────────────────────────────────────────────────
  confirmBtn.addEventListener("click", async () => {
    if (!currentSession || selectedIndex == null) return;
    clearErr(chooserErr);

    const checked = optionsList.querySelector<HTMLInputElement>(".option-radio:checked");
    if (!checked) return;
    const card = checked.closest(".option-card") as HTMLElement;
    const idx = parseInt(checked.value, 10);
    const originalOpt = currentSession.operationalized_options[idx];

    const dateStr = (card.querySelector(".option-deadline") as HTMLInputElement).value;
    const deadlineIso = dateStr ? new Date(`${dateStr}T23:59:59Z`).toISOString() : originalOpt.deadline;
    const outcomeEditor = card.querySelector(".outcome-editor") as HTMLElement;
    const { outcome_options, outcome_unit } = readOutcomeEditor(outcomeEditor, originalOpt);

    const selectedOption: OperationalizedQuestion = {
      ...originalOpt,
      text: (card.querySelector(".option-text") as HTMLElement).innerText.trim(),
      resolution_criteria: (card.querySelector(".option-criteria") as HTMLElement).innerText.trim(),
      resolution_source: (card.querySelector(".option-source") as HTMLElement).innerText.trim(),
      deadline: deadlineIso,
      outcome_type: originalOpt.outcome_type ?? "binary",
      outcome_options,
      outcome_unit,
      void_conditions: (card.querySelector(".option-void") as HTMLElement).innerText.trim(),
    };

    confirmBtn.disabled = true;
    backBtn.disabled = true;
    chooserLoading.hidden = false;
    try {
      const finalSession = await selectOperationalization(
        currentSession.id,
        selectedOption,
        feedbackEl.value.trim() || null,
      );
      currentSession = finalSession;
      setSession(finalSession);
      document.dispatchEvent(new CustomEvent("testdraft:phase", { detail: { phase: "think" } }));
    } catch (err) {
      showErr(chooserErr, `Error: ${err instanceof Error ? err.message : String(err)}`);
      confirmBtn.disabled = false;
    } finally {
      backBtn.disabled = false;
      chooserLoading.hidden = true;
    }
  });

  backBtn.addEventListener("click", () => {
    chooserScreen.hidden = true;
    inputScreen.hidden = false;
  });

  // ─── Reset on Start over (Show phase emits phase:ask) ──────────────────────
  document.addEventListener("testdraft:entered", (e: Event) => {
    if ((e as CustomEvent).detail?.phase !== "ask") return;
    // Only hard-reset if we already completed a run.
    if (currentSession && currentSession.status === "complete") {
      currentSession = null;
      selectedIndex = null;
      clearSession();
      optionsList.innerHTML = "";
      feedbackEl.value = "";
      chooserScreen.hidden = true;
      inputScreen.hidden = false;
      clearErr(inputErr);
      clearErr(chooserErr);
    }
  });
</script>

<style>
  .ask { width: 100%; }
  .ask h2 { font-size: 1.4rem; font-weight: 500; color: var(--color-primary); margin: 0 0 0.25rem; }
  .ask-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
  .opt { font-weight: 400; text-transform: none; letter-spacing: 0; }

  .field-label {
    display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 0.35rem;
  }
  .td-input {
    width: 100%; box-sizing: border-box; background: var(--color-bg);
    border: 1px solid var(--color-border); border-radius: 10px; padding: 0.7rem 0.85rem;
    font: inherit; color: var(--color-text); margin-bottom: 1rem; resize: vertical;
  }
  .td-input:focus {
    outline: none; border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }
  .ask-row { display: flex; gap: 1rem; }
  .ask-col { flex: 1; }

  .td-btn {
    background: var(--color-primary); color: #fff; border: none; border-radius: 999px;
    padding: 0.6rem 1.3rem; font: inherit; font-weight: 500; cursor: pointer;
    transition: filter 0.15s ease, transform 0.05s ease;
  }
  .td-btn:hover:not(:disabled) { filter: brightness(1.07); }
  .td-btn:active { transform: translateY(1px); }
  .td-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .td-btn--ghost { background: transparent; color: var(--color-text-muted); border: 1px solid var(--color-border); }

  .ask-actions { display: flex; gap: 0.6rem; align-items: center; margin-top: 0.25rem; }

  .ask-err {
    color: #e05c5c; font-size: 0.85rem; margin-bottom: 0.75rem;
    padding: 0.5rem 0.75rem; background: rgba(224, 92, 92, 0.1); border-radius: 8px;
  }
  .ask-loading { display: flex; align-items: center; gap: 0.6rem; margin-top: 1rem; color: var(--color-text-muted); font-size: 0.85rem; }
  .spinner {
    width: 18px; height: 18px; border: 2px solid var(--color-border);
    border-top-color: var(--color-primary); border-radius: 50%;
    animation: spin 0.8s linear infinite; flex-shrink: 0;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .orig-q {
    margin: 0 0 1.25rem; padding: 0.85rem 1rem; background: var(--color-surface);
    border-left: 3px solid var(--color-primary); border-radius: 8px;
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  .orig-q-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-muted); }
  .orig-q p { margin: 0; font-size: 0.95rem; color: var(--color-text); line-height: 1.4; }

  /* ─── Chooser cards ─── */
  .options-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; }
  .option-card {
    background: var(--color-surface); border: 2px solid var(--color-border);
    border-radius: 12px; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .option-card:has(.option-radio:checked) {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }
  .option-summary { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1.1rem; cursor: pointer; }
  .option-radio { accent-color: var(--color-primary); width: 18px; height: 18px; cursor: pointer; flex-shrink: 0; }
  .option-index { font-size: 0.7rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.05em; min-width: 1.5rem; }
  .option-text { flex: 1; font-size: 1rem; font-weight: 500; margin: 0; }
  .option-toggle {
    background: transparent; border: 1px solid var(--color-border); border-radius: 6px;
    padding: 0.25rem 0.6rem; font: inherit; font-size: 0.75rem; color: var(--color-text-muted);
    cursor: pointer; flex-shrink: 0;
  }
  .option-toggle:hover { color: var(--color-text); }
  .option-details {
    padding: 1rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .option-details[hidden] { display: none; }
  .option-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .option-field--row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field-text {
    margin: 0; font-size: 0.9rem; line-height: 1.5; color: var(--color-text);
    border-radius: 4px; padding: 4px 6px; transition: background 0.15s; outline: none;
  }
  .field-text[contenteditable="true"] { cursor: text; }
  .field-text[contenteditable="true"]:hover { background: color-mix(in srgb, var(--color-primary) 6%, transparent); }
  .field-text[contenteditable="true"]:focus { background: color-mix(in srgb, var(--color-primary) 10%, transparent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-primary) 30%, transparent); }
  .outcome-type-badge {
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.04em; padding: 0.05rem 0.4rem;
    border-radius: 999px; background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary); text-transform: lowercase;
  }
  .option-deadline, .outcome-editor input {
    background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 6px;
    padding: 0.35rem 0.5rem; font: inherit; font-size: 0.85rem; color: var(--color-text); box-sizing: border-box;
  }
  .option-deadline { width: 100%; }
  .outcome-editor { display: flex; gap: 0.4rem; align-items: center; margin-top: 0.25rem; }
  .outcome-editor input[type="number"] { width: 8rem; }
  .outcome-editor input[type="date"] { width: 100%; }
  .outcome-editor .outcome-unit { font-size: 0.85rem; color: var(--color-text); padding: 4px 6px; border-radius: 4px; }

  .feedback-field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
  .feedback-field textarea {
    width: 100%; box-sizing: border-box; background: var(--color-bg);
    border: 1px solid var(--color-border); border-radius: 8px; padding: 0.6rem 0.8rem;
    font: inherit; font-size: 0.9rem; color: var(--color-text); resize: vertical;
  }
  .feedback-field textarea:focus { outline: none; border-color: var(--color-primary); }

  [hidden] { display: none !important; }
</style>
