---
/**
 * THINK phase — rectangular treemap with a weekly timeline.
 *
 * Nested tiles: core question ⊃ major categories ⊃ their minor markets.
 * d3.treemap (resquarify tiling for stable transitions) sizes each leaf tile by
 * its current probability, so the map re-flows as you scrub/play through the
 * weekly time series. Major tiles carry the question label; leaf tiles show the
 * live %. Hover any leaf for the exact value + date + source. Core estimate is
 * the running mean, shown top-left.
 *
 * Data comes from session-store (set by the Ask phase). Boots on
 * `testdraft:entered` -> { phase: "think" }; emits `testdraft:phase`
 * -> { phase: "show" }.
 */
---

<section class="think">
  <div class="think-head">
    <div>
      <h2>Think</h2>
      <p class="think-sub" id="td-core-q">Decomposing…</p>
    </div>
    <button class="td-btn" id="td-to-show" disabled>See the answer →</button>
  </div>

  <div class="tree-wrap">
    <div class="core-readout">
      <span class="core-big" id="td-core-pct">—</span>
      <span class="core-cap">core estimate</span>
    </div>
    <svg id="td-tree" role="img" aria-label="Forecast treemap"></svg>
    <div class="bubble-tip" id="td-tip" hidden></div>

    <div class="timeline" id="td-timeline">
      <button class="play-btn" id="td-play" aria-label="Play">▶</button>
      <input type="range" id="td-scrub" min="0" max="0" value="0" step="1" />
      <span class="tl-date" id="td-date">—</span>
    </div>

    <div class="legend" id="td-legend"></div>
  </div>
</section>

<script>
  import * as d3 from "d3";
  import { minorProbAt, coreProbAt, lastIndex, pct, type Forecast, type Minor } from "../../data/forecast";
  import { getForecast } from "../../scripts/session-store";

  const W = 640, H = 440;
  const PAD_TOP = 26, PAD_INNER = 3, PAD_OUTER = 3;
  const FLOOR = 0.02; // min leaf value so low-prob tiles stay visible/hoverable
  const STEP_MS = 260;

  const svgEl = document.getElementById("td-tree") as unknown as SVGSVGElement;
  const coreQ = document.getElementById("td-core-q")!;
  const corePct = document.getElementById("td-core-pct")!;
  const dateLabel = document.getElementById("td-date")!;
  const scrub = document.getElementById("td-scrub") as HTMLInputElement;
  const playBtn = document.getElementById("td-play") as HTMLButtonElement;
  const toShowBtn = document.getElementById("td-to-show") as HTMLButtonElement;
  const timelineEl = document.getElementById("td-timeline")!;
  const legend = document.getElementById("td-legend")!;
  const tip = document.getElementById("td-tip")!;

  interface LeafDatum { minor: Minor; color: string; order: number; }
  interface LeafRef {
    minor: Minor; color: string;
    g: SVGGElement; rect: SVGRectElement; label: SVGTextElement; pctText: SVGTextElement; hit: SVGRectElement;
  }
  interface MajRef { id: string; rect: SVGRectElement; label: SVGForeignObjectElement | SVGTextElement; }

  let fc: Forecast | null = null;
  let root: d3.HierarchyNode<any> | null = null;
  let leafRefs: LeafRef[] = [];
  let majRefs: MajRef[] = [];
  let treemap: d3.TreemapLayout<any> | null = null;
  let idx = 0;
  let timer: number | null = null;

  function buildData(f: Forecast) {
    let order = 0;
    return {
      core: f.core,
      children: f.majors.map((m) => ({
        id: m.id, label: m.label, color: m.color,
        children: m.minors.map((mn): LeafDatum => ({ minor: mn, color: m.color, order: order++ })),
      })),
    };
  }

  function relayout(i: number) {
    if (!root || !treemap) return;
    root.sum((d: any) => (d.minor ? Math.max(FLOOR, minorProbAt(d.minor, i)) : 0));
    treemap(root);
  }

  function truncate(s: string, w: number): string {
    const max = Math.floor(w / 6.4);
    return s.length > max ? s.slice(0, Math.max(0, max - 1)) + "…" : s;
  }

  function render(f: Forecast) {
    fc = f;
    coreQ.textContent = f.core;

    const svg = d3.select(svgEl);
    svg.selectAll("*").remove();
    svg.attr("viewBox", `0 0 ${W} ${H}`).attr("preserveAspectRatio", "xMidYMid meet");

    root = d3.hierarchy<any>(buildData(f))
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
    treemap = d3.treemap<any>()
      .size([W, H])
      .tile(d3.treemapResquarify)
      .paddingOuter(PAD_OUTER)
      .paddingTop(PAD_TOP)
      .paddingInner(PAD_INNER)
      .round(true);

    relayout(0);

    const majNodes = root.descendants().filter((n) => n.depth === 1);
    const leafNodes = root.descendants().filter((n) => n.depth === 2);

    // Major group tiles + question labels
    const majLayer = svg.append("g");
    majRefs = majNodes.map((n: any) => {
      const rect = majLayer.append("rect")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .attr("rx", 10)
        .attr("fill", `color-mix(in srgb, ${n.data.color} 8%, var(--color-bg))`)
        .attr("stroke", n.data.color).attr("stroke-width", 1.5).attr("stroke-opacity", 0.55)
        .node() as SVGRectElement;
      const label = majLayer.append("text")
        .attr("class", "maj-label").attr("x", n.x0 + 8).attr("y", n.y0 + 17)
        .attr("fill", n.data.color).text(truncate(n.data.label, n.x1 - n.x0 - 12))
        .node() as SVGTextElement;
      return { id: n.data.id, rect, label } as MajRef;
    });

    // Leaf tiles
    const leafLayer = svg.append("g");
    leafRefs = leafNodes.map((n: any) => {
      const c = n.data.color;
      const g = leafLayer.append("g").node() as SVGGElement;
      const gs = d3.select(g);
      const rect = gs.append("rect")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .attr("rx", 6).attr("fill", c).attr("fill-opacity", 0.85)
        .node() as SVGRectElement;
      const label = gs.append("text")
        .attr("class", "leaf-label").attr("x", (n.x0 + n.x1) / 2).attr("y", (n.y0 + n.y1) / 2 - 5)
        .attr("text-anchor", "middle").text("")
        .node() as SVGTextElement;
      const pctText = gs.append("text")
        .attr("class", "leaf-pct").attr("x", (n.x0 + n.x1) / 2).attr("y", (n.y0 + n.y1) / 2 + 11)
        .attr("text-anchor", "middle").text("")
        .node() as SVGTextElement;
      const hit = gs.append("rect")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .attr("fill", "transparent").style("cursor", "pointer")
        .node() as SVGRectElement;
      const ref: LeafRef = { minor: n.data.minor, color: c, g, rect, label, pctText, hit };
      attachHover(hit, ref);
      return ref;
    });

    // Legend
    legend.innerHTML = "";
    f.majors.forEach((m) => {
      const item = document.createElement("div");
      item.className = "legend-item";
      item.innerHTML = `<span class="legend-dot" style="background:${m.color}"></span><span>${m.label}</span>`;
      legend.appendChild(item);
    });

    const li = lastIndex(f);
    scrub.max = String(li);
    timelineEl.style.display = li > 0 ? "" : "none";
  }

  function paint(dur: number) {
    if (!root) return;
    const byId = new Map<string, any>();
    root.descendants().forEach((n: any) => { if (n.data.id) byId.set(n.data.id, n); });
    const leafNodes = root.descendants().filter((n: any) => n.depth === 2);

    // Majors
    majRefs.forEach((m) => {
      const n = byId.get(m.id);
      if (!n) return;
      const w = n.x1 - n.x0, h = n.y1 - n.y0;
      d3.select(m.rect).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", w).attr("height", h);
      d3.select(m.label).transition().duration(dur).attr("x", n.x0 + 8).attr("y", n.y0 + 17);
      (m.label as SVGTextElement).textContent = truncate(n.data.label, w - 12);
    });

    // Leaves
    leafRefs.forEach((lf, i) => {
      const n: any = leafNodes[i];
      if (!n) return;
      const w = n.x1 - n.x0, h = n.y1 - n.y0;
      const cx = (n.x0 + n.x1) / 2, cy = (n.y0 + n.y1) / 2;
      d3.select(lf.rect).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", w).attr("height", h);
      d3.select(lf.hit).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", w).attr("height", h);
      d3.select(lf.pctText).transition().duration(dur).attr("x", cx).attr("y", h > 34 ? cy + 11 : cy + 4);
      d3.select(lf.label).transition().duration(dur).attr("x", cx).attr("y", cy - 5);

      const p = minorProbAt(lf.minor, idx);
      lf.pctText.textContent = w > 40 && h > 22 ? pct(p) : "";
      lf.label.textContent = w > 82 && h > 50 ? truncate(lf.minor.label, w - 10) : "";
    });
  }

  function update(i: number, dur = STEP_MS) {
    if (!fc) return;
    idx = i;
    relayout(i);
    paint(dur);
    corePct.textContent = pct(coreProbAt(fc, i));
    dateLabel.textContent = fc.dates[i] ?? "";
    scrub.value = String(i);
  }

  function attachHover(el: SVGRectElement, lf: LeafRef) {
    el.addEventListener("mousemove", (ev) => {
      const wrap = (svgEl.parentElement as HTMLElement).getBoundingClientRect();
      tip.hidden = false;
      tip.style.left = `${ev.clientX - wrap.left}px`;
      tip.style.top = `${ev.clientY - wrap.top}px`;
      tip.innerHTML =
        `<span class="tip-q">${lf.minor.label}</span>` +
        `<span class="tip-v" style="color:${lf.color}">${(minorProbAt(lf.minor, idx) * 100).toFixed(1)}%</span>` +
        `<span class="tip-d">${(fc?.dates[idx] ?? "")} · ${lf.minor.source}</span>`;
    });
    el.addEventListener("mouseleave", () => { tip.hidden = true; });
  }

  function stop() {
    if (timer !== null) { clearInterval(timer); timer = null; }
    playBtn.textContent = "▶";
  }
  function play() {
    if (!fc) return;
    stop();
    const li = lastIndex(fc);
    if (idx >= li) idx = 0;
    playBtn.textContent = "⏸";
    timer = window.setInterval(() => {
      const last = lastIndex(fc!);
      if (idx >= last) { stop(); toShowBtn.disabled = false; return; }
      update(idx + 1);
    }, STEP_MS);
  }

  function boot() {
    const f = getForecast();
    if (!f || !f.majors.length) {
      coreQ.textContent = "No forecast data — start again from Ask.";
      toShowBtn.disabled = false;
      return;
    }
    render(f);
    idx = 0;
    update(0, 0);
    if (lastIndex(f) === 0) { toShowBtn.disabled = false; return; }
    setTimeout(play, 350);
  }

  playBtn.addEventListener("click", () => (timer === null ? play() : stop()));
  scrub.addEventListener("input", () => { stop(); update(parseInt(scrub.value, 10), 120); });
  document.addEventListener("testdraft:entered", (e: Event) => {
    if ((e as CustomEvent).detail?.phase === "think") boot();
  });
  toShowBtn.addEventListener("click", () => {
    stop();
    document.dispatchEvent(new CustomEvent("testdraft:phase", { detail: { phase: "show" } }));
  });
</script>

<style>
  .think { width: 100%; }
  .think-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .think h2 { font-size: 1.4rem; font-weight: 500; color: var(--color-primary); margin: 0 0 0.2rem; }
  .think-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0; max-width: 520px; line-height: 1.4; }
  .td-btn { background: var(--color-primary); color: #fff; border: none; border-radius: 999px; padding: 0.55rem 1.15rem; font: inherit; font-weight: 500; cursor: pointer; transition: filter 0.15s ease; }
  .td-btn:hover:not(:disabled) { filter: brightness(1.07); }
  .td-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .tree-wrap { background: var(--color-surface); border-radius: 16px; padding: 1rem; position: relative; }
  .core-readout { position: absolute; top: 1.2rem; left: 1.4rem; display: flex; flex-direction: column; line-height: 1; z-index: 2; pointer-events: none; }
  .core-big { font-size: 2rem; font-weight: 700; color: var(--color-primary); text-shadow: 0 1px 4px var(--color-surface), 0 0 3px var(--color-surface); }
  .core-cap { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin-top: 0.2rem; }
  #td-tree { width: 100%; height: auto; display: block; max-width: 640px; margin: 0 auto; }

  .bubble-tip {
    position: absolute; z-index: 5; pointer-events: none;
    transform: translate(-50%, calc(-100% - 14px));
    background: var(--color-bg); border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md); border-radius: 10px; padding: 0.5rem 0.65rem;
    max-width: 230px; display: flex; flex-direction: column; gap: 0.15rem;
  }
  .bubble-tip .tip-q { font-size: 0.72rem; color: var(--color-text); line-height: 1.25; }
  .bubble-tip .tip-v { font-size: 1rem; font-weight: 700; }
  .bubble-tip .tip-d { font-size: 0.66rem; color: var(--color-text-muted); }

  .timeline { display: flex; align-items: center; gap: 0.8rem; margin-top: 0.5rem; padding: 0 0.5rem; }
  .play-btn { width: 2.2rem; height: 2.2rem; border-radius: 999px; border: none; background: var(--color-primary); color: #fff; font-size: 0.9rem; cursor: pointer; flex-shrink: 0; }
  #td-scrub { flex: 1; accent-color: var(--color-primary); }
  .tl-date { font-size: 0.82rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; min-width: 5.5rem; text-align: right; }

  .legend { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.9rem; padding: 0 0.5rem; }
  .legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--color-text-muted); }
  .legend-dot { width: 0.7rem; height: 0.7rem; border-radius: 999px; flex-shrink: 0; }

  :global(#td-tree .leaf-pct) { font-weight: 700; fill: #fff; pointer-events: none; font-size: 13px; }
  :global(#td-tree .leaf-label) { fill: rgba(255,255,255,0.92); pointer-events: none; font-size: 10px; font-weight: 500; }
  :global(#td-tree .maj-label) { font-family: "Roboto", system-ui, sans-serif; font-size: 12px; font-weight: 700; pointer-events: none; }
</style>
