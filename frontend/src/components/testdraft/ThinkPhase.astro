---
/**
 * THINK phase — traditional treemap.
 *
 * Nested rectangles: core question ⊃ 3 major categories ⊃ their minor markets.
 * Leaf area ∝ current probability. Stepping the timeline re-lays out the
 * treemap each week, so rectangles grow/shrink over time. Major bands show the
 * category QUESTION; leaves show their live %. Hover a leaf → exact value + date.
 *
 * Emits `testdraft:phase` -> { phase: "show" }. Re-arms on `testdraft:entered`.
 */
---

<section class="think">
  <div class="think-head">
    <div>
      <h2>Think</h2>
      <p class="think-sub" id="td-core-q">Decomposing…</p>
    </div>
    <button class="td-btn" id="td-to-show" disabled>See the answer →</button>
  </div>

  <div class="tree-wrap">
    <div class="tm-topbar">
      <div class="core-readout">
        <span class="core-big" id="td-core-pct">—</span>
        <span class="core-cap">core estimate</span>
      </div>
      <div class="legend" id="td-legend"></div>
    </div>

    <div class="stage" id="td-stage">
      <svg id="td-tree" role="img" aria-label="Forecast treemap"></svg>
    </div>
    <div class="bubble-tip" id="td-tip" hidden></div>

    <div class="timeline">
      <button class="play-btn" id="td-play" aria-label="Play">▶</button>
      <input type="range" id="td-scrub" min="0" max="0" value="0" step="1" />
      <span class="tl-date" id="td-date">—</span>
    </div>
  </div>
</section>

<script>
  import * as d3 from "d3";
  import { forecast, minorProbAt, LAST_INDEX, pct, type Minor } from "../../data/forecast";

  const W = 900, H = 560, STEP_MS = 220, PAD_TOP = 26;

  const stage = document.getElementById("td-stage")!;
  const svgEl = document.getElementById("td-tree") as unknown as SVGSVGElement;
  const coreQ = document.getElementById("td-core-q")!;
  const corePct = document.getElementById("td-core-pct")!;
  const dateLabel = document.getElementById("td-date")!;
  const scrub = document.getElementById("td-scrub") as HTMLInputElement;
  const playBtn = document.getElementById("td-play") as HTMLButtonElement;
  const toShowBtn = document.getElementById("td-to-show") as HTMLButtonElement;
  const legend = document.getElementById("td-legend")!;
  const tip = document.getElementById("td-tip")!;

  interface LeafRef {
    node: d3.HierarchyRectangularNode<any>;
    minor: Minor; color: string;
    rect: SVGRectElement; fo: SVGForeignObjectElement; div: HTMLElement;
  }

  let root: d3.HierarchyRectangularNode<any> | null = null;
  let leaves: LeafRef[] = [];
  let majorSel: { node: d3.HierarchyRectangularNode<any>; rect: SVGRectElement; label: SVGForeignObjectElement; div: HTMLElement }[] = [];
  let timer: number | null = null;
  let idx = 0;

  const treemap = d3.treemap<any>().size([W, H]).paddingOuter(4).paddingTop(PAD_TOP).paddingInner(4).round(true);

  function hexRgb(h: string) {
    const m = h.replace("#", "");
    const n = parseInt(m.length === 3 ? m.split("").map((c) => c + c).join("") : m, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  function lighten(hex: string, amt: number) {
    const [r, g, b] = hexRgb(hex);
    const mix = (c: number) => Math.round(c + (255 - c) * amt);
    return `rgb(${mix(r)},${mix(g)},${mix(b)})`;
  }

  function buildData() {
    return { name: "core", children: forecast.majors.map((m) => ({
      name: m.label, color: m.color,
      children: m.minors.map((mn) => ({ name: mn.label, color: m.color, minor: mn, _v: mn.series[0].p })),
    })) };
  }

  function render() {
    coreQ.textContent = forecast.core;

    root = d3.hierarchy<any>(buildData())
      .sum((d) => d._v ?? 0)
      .sort((a, b) => (b.value ?? 0) - (a.value ?? 0)) as d3.HierarchyRectangularNode<any>;
    treemap(root);

    const svg = d3.select(svgEl);
    svg.selectAll("*").remove();
    svg.attr("viewBox", `0 0 ${W} ${H}`).attr("preserveAspectRatio", "none");

    const majorNodes = root.children ?? [];
    const leafNodes = root.leaves();

    // Major cluster rectangles + question band
    majorSel = majorNodes.map((n) => {
      const rect = svg.append("rect")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .attr("rx", 8).attr("fill", lighten(n.data.color, 0.86))
        .attr("stroke", n.data.color).attr("stroke-width", 1.5).attr("stroke-opacity", 0.5)
        .node() as SVGRectElement;
      const fo = svg.append("foreignObject")
        .attr("x", n.x0 + 6).attr("y", n.y0 + 3).attr("width", Math.max(0, n.x1 - n.x0 - 12)).attr("height", PAD_TOP - 4)
        .node() as SVGForeignObjectElement;
      const div = document.createElement("div");
      div.className = "tm-maj";
      div.style.setProperty("--mc", n.data.color);
      div.textContent = n.data.name;
      fo.appendChild(div);
      return { node: n, rect, label: fo, div };
    });

    // Leaf rectangles
    leaves = leafNodes.map((n, i) => {
      const rect = svg.append("rect")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .attr("rx", 5).attr("fill", lighten(n.data.color, 0.35 + (i % 3) * 0.12))
        .node() as SVGRectElement;
      const fo = svg.append("foreignObject")
        .attr("x", n.x0).attr("y", n.y0).attr("width", n.x1 - n.x0).attr("height", n.y1 - n.y0)
        .node() as SVGForeignObjectElement;
      const div = document.createElement("div");
      div.className = "tm-leaf";
      fo.appendChild(div);
      const ref: LeafRef = { node: n, minor: n.data.minor, color: n.data.color, rect, fo, div };
      attachHover(rect, ref);
      attachHover(fo, ref);
      return ref;
    });

    // Legend
    legend.innerHTML = "";
    forecast.majors.forEach((m) => {
      const item = document.createElement("div");
      item.className = "legend-item";
      item.innerHTML = `<span class="legend-dot" style="background:${m.color}"></span><span>${m.label}</span>`;
      legend.appendChild(item);
    });

    scrub.max = String(LAST_INDEX);
    draw(false);
  }

  function draw(animate: boolean) {
    const dur = animate ? STEP_MS - 30 : 0;

    majorSel.forEach((m) => {
      const n = m.node;
      d3.select(m.rect).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", Math.max(0, n.x1 - n.x0)).attr("height", Math.max(0, n.y1 - n.y0));
      d3.select(m.label).transition().duration(dur)
        .attr("x", n.x0 + 6).attr("y", n.y0 + 3).attr("width", Math.max(0, n.x1 - n.x0 - 12));
    });

    leaves.forEach((lf) => {
      const n = lf.node;
      const w = Math.max(0, n.x1 - n.x0), h = Math.max(0, n.y1 - n.y0);
      d3.select(lf.rect).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", w).attr("height", h);
      d3.select(lf.fo).transition().duration(dur)
        .attr("x", n.x0).attr("y", n.y0).attr("width", w).attr("height", h);
      const p = lf.node.data._v as number;
      lf.div.innerHTML =
        (w > 60 && h > 44 ? `<span class="tm-q">${lf.minor.label}</span>` : "") +
        `<span class="tm-pct">${pct(p)}</span>`;
      lf.div.style.color = "#20303f";
    });
  }

  function attachHover(el: Element, lf: LeafRef) {
    (el as HTMLElement).style.cursor = "pointer";
    el.addEventListener("mousemove", (ev) => {
      const e = ev as MouseEvent;
      const wrap = (stage.parentElement as HTMLElement).getBoundingClientRect();
      tip.hidden = false;
      tip.style.left = `${e.clientX - wrap.left}px`;
      tip.style.top = `${e.clientY - wrap.top}px`;
      tip.innerHTML =
        `<span class="tip-q">${lf.minor.label}</span>` +
        `<span class="tip-v" style="color:${lf.color}">${((lf.node.data._v as number) * 100).toFixed(1)}%</span>` +
        `<span class="tip-d">${forecast.dates[idx] ?? ""} · ${lf.minor.source}</span>`;
    });
    el.addEventListener("mouseleave", () => { tip.hidden = true; });
  }

  function update(i: number) {
    idx = i;
    if (!root) return;
    let sum = 0;
    for (const lf of leaves) { const p = minorProbAt(lf.minor, i); lf.node.data._v = p; sum += p; }
    root.sum((d) => d._v ?? 0);
    treemap(root);
    draw(true);
    corePct.textContent = pct(sum / leaves.length);
    dateLabel.textContent = forecast.dates[i] ?? "";
    scrub.value = String(i);
  }

  function stop() { if (timer !== null) { clearInterval(timer); timer = null; } playBtn.textContent = "▶"; }
  function play() {
    stop(); if (idx >= LAST_INDEX) idx = 0; playBtn.textContent = "⏸";
    timer = window.setInterval(() => {
      if (idx >= LAST_INDEX) { stop(); toShowBtn.disabled = false; return; }
      update(idx + 1);
    }, STEP_MS);
  }
  function boot() { render(); idx = 0; update(0); setTimeout(play, 350); }

  playBtn.addEventListener("click", () => (timer === null ? play() : stop()));
  scrub.addEventListener("input", () => { stop(); update(parseInt(scrub.value, 10)); });
  document.addEventListener("testdraft:entered", (e: Event) => {
    if ((e as CustomEvent).detail?.phase === "think") boot();
  });
  toShowBtn.addEventListener("click", () => {
    stop();
    document.dispatchEvent(new CustomEvent("testdraft:phase", { detail: { phase: "show" } }));
  });
</script>

<style>
  .think { width: 100%; }
  .think-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .think h2 { font-size: 1.4rem; font-weight: 500; color: var(--color-primary); margin: 0 0 0.2rem; }
  .think-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0; max-width: 520px; line-height: 1.4; }
  .td-btn { background: var(--color-primary); color: #fff; border: none; border-radius: 999px; padding: 0.55rem 1.15rem; font: inherit; font-weight: 500; cursor: pointer; transition: filter 0.15s ease; }
  .td-btn:hover:not(:disabled) { filter: brightness(1.07); }
  .td-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .tree-wrap { background: var(--color-surface); border-radius: 16px; padding: 1rem; position: relative; }
  .tm-topbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .core-readout { display: flex; flex-direction: column; line-height: 1; }
  .core-big { font-size: 2rem; font-weight: 700; color: var(--color-primary); }
  .core-cap { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin-top: 0.2rem; }

  .stage { position: relative; width: 100%; }
  #td-tree { width: 100%; height: auto; display: block; aspect-ratio: 900 / 560; }

  .bubble-tip {
    position: absolute; z-index: 5; pointer-events: none; transform: translate(-50%, calc(-100% - 14px));
    background: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow-md);
    border-radius: 10px; padding: 0.5rem 0.65rem; max-width: 240px; display: flex; flex-direction: column; gap: 0.15rem;
  }
  :global(.bubble-tip .tip-q) { font-size: 0.72rem; color: var(--color-text); line-height: 1.25; }
  :global(.bubble-tip .tip-v) { font-size: 1rem; font-weight: 700; }
  :global(.bubble-tip .tip-d) { font-size: 0.66rem; color: var(--color-text-muted); }

  .timeline { display: flex; align-items: center; gap: 0.8rem; margin-top: 0.7rem; padding: 0 0.25rem; }
  .play-btn { width: 2.2rem; height: 2.2rem; border-radius: 999px; border: none; background: var(--color-primary); color: #fff; font-size: 0.9rem; cursor: pointer; flex-shrink: 0; }
  #td-scrub { flex: 1; accent-color: var(--color-primary); }
  .tl-date { font-size: 0.82rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; min-width: 5.5rem; text-align: right; }

  .legend { display: flex; flex-direction: column; gap: 0.3rem; }
  :global(.legend-item) { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--color-text-muted); max-width: 340px; }
  :global(.legend-dot) { width: 0.7rem; height: 0.7rem; border-radius: 3px; flex-shrink: 0; }

  :global(.tm-maj) {
    font-family: "Roboto", system-ui, sans-serif; font-size: 0.72rem; font-weight: 700; color: var(--mc);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: calc(26px - 6px);
    pointer-events: none;
  }
  :global(.tm-leaf) {
    width: 100%; height: 100%; box-sizing: border-box; padding: 5px 7px; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; pointer-events: none;
    font-family: "Roboto", system-ui, sans-serif;
  }
  :global(.tm-leaf .tm-q) { font-size: 0.68rem; line-height: 1.2; opacity: 0.85; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 2px; }
  :global(.tm-leaf .tm-pct) { font-size: 1.05rem; font-weight: 700; }
</style>
