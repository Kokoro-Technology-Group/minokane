---
/**
 * SHOW phase — the answer, read top-down, from the real forecast data.
 *
 *   #  core estimate (aggregated probability + question)
 *   ## one per major category, expandable (arrow) to reveal its minor markets
 *      + an interactive chart (auto-ranged, hover for exact value + date).
 *
 * Chart geometry is computed at build time (data is static); hover interaction
 * runs client-side.
 */
import { forecast, majorProbAt, coreProbAt, LAST_INDEX, pct, type Minor } from "../../data/forecast";

const W = 220, H = 60, PADX = 4, PADT = 8, PADB = 8;

function chart(m: Minor) {
  const ser = m.series;
  const ps = ser.map((s) => s.p);
  let lo = Math.min(...ps), hi = Math.max(...ps);
  if (hi - lo < 0.02) { lo -= 0.05; hi += 0.05; }
  const n = ser.length;
  const X = (i: number) => PADX + (i / (n - 1)) * (W - 2 * PADX);
  const Y = (p: number) => PADT + (1 - (p - lo) / (hi - lo)) * (H - PADT - PADB);
  const pts = ser.map((s, i) => ({ x: +X(i).toFixed(1), y: +Y(s.p).toFixed(1), p: s.p, d: s.date }));
  const line = "M" + pts.map((p) => `${p.x},${p.y}`).join(" L");
  const area = `M${pts[0].x},${H - PADB} L` + pts.map((p) => `${p.x},${p.y}`).join(" L") + ` L${pts[n - 1].x},${H - PADB} Z`;
  return { pts, line, area };
}

const coreFinal = coreProbAt(forecast, LAST_INDEX);
---

<section class="show">
  <div class="answer-head">
    <span class="answer-eyebrow">Core estimate</span>
    <h1 class="answer-headline">{pct(coreFinal)} likely</h1>
    <p class="answer-summary">{forecast.core}</p>
    <div class="answer-bar"><div class="answer-bar-fill" style={`width:${coreFinal * 100}%`}></div></div>
  </div>

  <div class="subs">
    {
      forecast.majors.map((maj) => {
        const majFinal = majorProbAt(maj, LAST_INDEX);
        return (
          <div class="sub" data-sub={maj.id}>
            <button class="sub-row" aria-expanded="false">
              <span class="sub-arrow" style={`color:${maj.color}`}>▸</span>
              <span class="sub-label">{maj.label}</span>
              <span class="sub-prob" style={`background:color-mix(in srgb, ${maj.color} 18%, transparent);color:${maj.color}`}>{pct(majFinal)}</span>
            </button>

            <div class="sub-panel" hidden>
              {maj.minors.map((leaf) => {
                const c = chart(leaf);
                return (
                  <div class="leaf">
                    <div class="leaf-main">
                      <span class="leaf-label">{leaf.label}</span>
                      <span class="leaf-source">{leaf.source}</span>
                    </div>
                    <div class="leaf-chart" data-pts={JSON.stringify(c.pts)} data-color={maj.color}>
                      <svg class="spark" viewBox={`0 0 ${W} ${H}`} width={W} height={H} preserveAspectRatio="none">
                        <path class="spark-area" d={c.area} fill={`color-mix(in srgb, ${maj.color} 16%, transparent)`} />
                        <path class="spark-line" d={c.line} fill="none" stroke={maj.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <line class="spark-guide" x1="0" y1={PADT} x2="0" y2={H - PADB} stroke={maj.color} stroke-width="1" stroke-dasharray="2 3" opacity="0" />
                        <circle class="spark-dot" r="3.5" fill={maj.color} stroke="var(--color-bg)" stroke-width="1.5" opacity="0" />
                      </svg>
                      <div class="chart-tip" hidden></div>
                    </div>
                    <span class="leaf-prob" style={`color:${maj.color}`}>{pct(leaf.final)}</span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="show-actions"><button class="td-btn td-btn--ghost" id="td-restart">↻ Start over</button></div>
</section>

<script>
  // Accordion
  document.querySelectorAll<HTMLButtonElement>(".sub-row").forEach((row) => {
    row.addEventListener("click", () => {
      const panel = row.nextElementSibling as HTMLElement;
      const open = row.getAttribute("aria-expanded") === "true";
      row.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
      (row.querySelector(".sub-arrow") as HTMLElement).style.transform = open ? "rotate(0deg)" : "rotate(90deg)";
    });
  });

  // Interactive charts — hover to read exact value + date
  interface P { x: number; y: number; p: number; d: string; }
  document.querySelectorAll<HTMLElement>(".leaf-chart").forEach((wrap) => {
    const pts: P[] = JSON.parse(wrap.dataset.pts || "[]");
    if (!pts.length) return;
    const svg = wrap.querySelector("svg") as SVGSVGElement;
    const guide = wrap.querySelector(".spark-guide") as SVGLineElement;
    const dot = wrap.querySelector(".spark-dot") as SVGCircleElement;
    const tipEl = wrap.querySelector(".chart-tip") as HTMLElement;
    const vbW = 220;

    function move(ev: PointerEvent | MouseEvent) {
      const rect = svg.getBoundingClientRect();
      const rel = (ev.clientX - rect.left) / rect.width; // 0..1
      const i = Math.max(0, Math.min(pts.length - 1, Math.round(rel * (pts.length - 1))));
      const p = pts[i];
      guide.setAttribute("x1", String(p.x)); guide.setAttribute("x2", String(p.x));
      guide.setAttribute("opacity", "0.7");
      dot.setAttribute("cx", String(p.x)); dot.setAttribute("cy", String(p.y));
      dot.setAttribute("opacity", "1");
      tipEl.hidden = false;
      tipEl.innerHTML = `<strong>${(p.p * 100).toFixed(1)}%</strong><span>${p.d}</span>`;
      tipEl.style.left = `${(p.x / vbW) * 100}%`;
    }
    function leave() {
      guide.setAttribute("opacity", "0");
      dot.setAttribute("opacity", "0");
      tipEl.hidden = true;
    }
    svg.addEventListener("pointermove", move);
    svg.addEventListener("pointerleave", leave);
  });

  document.getElementById("td-restart")!.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("testdraft:phase", { detail: { phase: "ask" } }));
  });
</script>

<style>
  .show { width: 100%; }

  .answer-head { background: var(--color-surface); border-radius: 16px; padding: 1.5rem 1.5rem 1.25rem; margin-bottom: 1.5rem; }
  .answer-eyebrow { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .answer-headline { font-size: 1.9rem; font-weight: 500; color: var(--color-primary); margin: 0.3rem 0 0.6rem; letter-spacing: -0.01em; }
  .answer-summary { margin: 0 0 1rem; color: var(--color-text); font-size: 0.95rem; line-height: 1.5; }
  .answer-bar { height: 8px; background: var(--color-bg); border-radius: 999px; overflow: hidden; }
  .answer-bar-fill { height: 100%; background: var(--color-primary); border-radius: 999px; transition: width 0.6s ease; }

  .subs { display: flex; flex-direction: column; gap: 0.6rem; }
  .sub { border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; background: var(--color-bg); }
  .sub-row { width: 100%; display: flex; align-items: center; gap: 0.7rem; padding: 0.9rem 1rem; background: transparent; border: none; font: inherit; text-align: left; cursor: pointer; color: var(--color-text); }
  .sub-row:hover { background: var(--color-surface); }
  .sub-arrow { font-size: 0.9rem; transition: transform 0.18s ease; flex-shrink: 0; }
  .sub-label { flex: 1; font-size: 1rem; font-weight: 500; }
  .sub-prob { font-size: 0.85rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; flex-shrink: 0; }

  .sub-panel { padding: 0.25rem 1rem 0.9rem 2.2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .leaf { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.6rem 0.75rem; background: var(--color-surface); border-radius: 10px; }
  .leaf-main { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 0; }
  .leaf-label { font-size: 0.9rem; color: var(--color-text); }
  .leaf-source { font-size: 0.75rem; color: var(--color-text-muted); }

  .leaf-chart { position: relative; width: 220px; flex-shrink: 0; }
  .spark { display: block; width: 220px; height: 60px; overflow: visible; }
  .chart-tip {
    position: absolute; top: -2.6rem; transform: translateX(-50%); pointer-events: none;
    background: var(--color-bg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);
    border-radius: 8px; padding: 0.25rem 0.5rem; display: flex; flex-direction: column; align-items: center;
    white-space: nowrap; line-height: 1.2;
  }
  .chart-tip strong { font-size: 0.85rem; }
  .chart-tip span { font-size: 0.62rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }

  .leaf-prob { font-size: 0.95rem; font-weight: 700; flex-shrink: 0; }

  .show-actions { margin-top: 1.5rem; }
  .td-btn { background: var(--color-primary); color: #fff; border: none; border-radius: 999px; padding: 0.55rem 1.2rem; font: inherit; font-weight: 500; cursor: pointer; }
  .td-btn--ghost { background: transparent; color: var(--color-text-muted); border: 1px solid var(--color-border); }
  [hidden] { display: none !important; }

  @media (max-width: 620px) {
    .leaf { flex-wrap: wrap; }
    .leaf-chart { width: 100%; }
    .spark { width: 100%; }
  }
</style>
